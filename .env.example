# 복사해서 .env 로 사용하세요:  cp .env.example .env
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=market.ticks
KAFKA_TOPIC_PARTITIONS=3

REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgres://mktlab:mktlab@localhost:5432/mktlab

API_PORT=4000

# ── 토스증권 Open API ──────────────────────────────────
# WTS 로그인 → 설정 → Open API 에서 발급. 호출 IP 허용 목록 등록 필수.
# 시크릿은 절대 커밋하지 마세요 (.env 는 .gitignore 에 있어야 합니다)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 폴링할 종목 (KRX 6자리 / 미국 티커, 콤마 구분. /api/v1/prices 는 한 번에 200개까지)
TOSS_SYMBOLS=005930,000660,035420,035720,005380,AAPL,NVDA,TSLA,MSFT,AMZN
# 현재가 폴링 주기(ms)
TOSS_POLL_MS=3000
# 종목명·전일종가 갱신 주기(분)
TOSS_META_REFRESH_MIN=30

# 파티션 키: symbol | random  <- 순서 보장 실험용 스위치
PRODUCER_PARTITION_KEY=symbol

# ── 슬랙 알림 ─────────────────────────────────────────
# 슬랙 앱 → Incoming Webhooks 에서 발급한 URL. 비우면 발송 안 함
SLACK_WEBHOOK_URL=
# 슬랙으로 보낼 시장 (KR | US | KR,US)
SLACK_ALERT_MARKETS=KR
# 이 심각도 이상만 슬랙 발송 (INFO | WARN | CRITICAL). 대시보드에는 전부 표시
SLACK_MIN_SEVERITY=WARN
# 페이퍼 체결(매수/매도) 슬랙 발송 (true | false)
SLACK_PAPER_TRADES=true
# 페이퍼 매매 전용 채널 웹훅 URL. 비우면 위 기본 채널로 발송
SLACK_PAPER_WEBHOOK_URL=

# ── 페이퍼 트레이딩 (실주문 없음, 시뮬레이션 전용) ──────────
# 전략 5개(평균회귀·추세추종·낙폭과대·초단타·신고가돌파)가 각자 독립 계좌로 동시 운용됩니다.
# 전략별 진입/청산 규칙은 services/src/domain/strategy.ts 에 있습니다.
PAPER_MARKETS=KR,US          # 매매 대상 시장
PAPER_INITIAL_CASH=100000000 # 전략별 초기 자금 (1억)
PAPER_POSITION_PCT=10        # 진입당 현금 비중(%)
PAPER_MAX_POSITIONS=5        # 전략당 동시 보유 종목 수 한도
PAPER_COOLDOWN_SEC=1800      # 같은 전략×종목 재진입 금지(초)
PAPER_MAX_HOLD_MIN=360       # 시간 청산: 이 시간(분) 넘게 보유하면 강제 청산
PAPER_DAILY_MAX_LOSS_PCT=2   # 일일 킬 스위치: 당일 -N% 손실 시 신규 진입 중단
PAPER_FEE_PCT=0.015          # 위탁 수수료 (편도 %)
PAPER_KR_SELL_TAX_PCT=0.15   # 국내 매도 거래세+농특세 (%)
PAPER_SLIPPAGE_PCT=0.05      # 슬리피지 추정 (편도 %)

# ── 알림 규칙 ─────────────────────────────────────────
ALERT_CHANGE_STEP=1        # 등락률 계단 간격(%). ±1%, ±2% ... 도달 시 알림
ALERT_SPIKE_WINDOW_SEC=60  # 급변 감시 윈도우(초)
ALERT_SPIKE_RATE=0.5       # 윈도우 내 이 %p 이상 움직이면 급변 알림
ALERT_COOLDOWN_SEC=300     # 같은 알림 재발송 금지 시간(초)
ALERT_STALE_TICK_SEC=600   # 이보다 오래된 체결 시각 틱은 알림 제외 (장 마감 후 스팸 방지)
